{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2017",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@legacy/*": ["./lib/*"]
    }
  },
  "include": [
    "src/__tests__",
    "__mocks__",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types"
  ],
  "exclude": ["node_modules", "e2e", "api"]
}
